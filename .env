# 🧠 Modelo principal
LUIZ_OPENAI_MODEL=gpt-4o-mini
LUIZ_PRIMARY_LLM=openai
LUIZ_DUAL_POLICY=single

# 💰 Controle de uso
LUIZ_DAILY_TOKEN_BUDGET=40000
LUIZ_QUOTA_WARNING_RATIO=0.70
LUIZ_QUOTA_SLEEP_RATIO=0.95
LUIZ_QUOTA_STATE_FILE=.luiz/quota_state.json

# 🎙️ Voz / ativação
LUIZ_WAKE_WORDS=luiz,luis, luís
LUIZ_STT_MODEL=tiny
LUIZ_SAMPLE_RATE=16000
LUIZ_INPUT_SECONDS=2.5
LUIZ_COMMAND_SECONDS=8
LUIZ_ENERGY_THRESHOLD=0.01

# 📂 Scripts locais
LUIZ_SCRIPTS_DIR=scripts